+    // Metodo agregado (no existe en @capacitor/share original, ver
+    // patches/@capacitor+share+8.0.1.patch): "compartir" (ACTION_SEND) es
+    // para MANDAR el archivo a otra app (WhatsApp, Gmail...). Esto es
+    // "abrir con" (ACTION_VIEW + chooser) -- el usuario elige con que app
+    // VER el archivo el mismo (Sheets, Excel, WPS, etc.), sin depender del
+    // visor interno de la app que lo recibio.
+    @PluginMethod
+    public void openFile(PluginCall call) {
+        String file = call.getString("path");
+        if (file == null || !isFileUrl(file)) {
+            call.reject("Se requiere un path de archivo (file://...)");
+            return;
+        }
+        try {
+            String type = getMimeType(file);
+            if (type == null) type = "*/*";
+
+            Uri fileUri = FileProvider.getUriForFile(
+                getActivity(),
+                getContext().getPackageName() + ".fileprovider",
+                new File(Uri.parse(file).getPath())
+            );
+
+            Intent intent = new Intent(Intent.ACTION_VIEW);
+            intent.setDataAndType(fileUri, type);
+            intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+
+            Intent chooser = Intent.createChooser(intent, call.getString("dialogTitle", "Abrir con"));
+            chooser.addCategory(Intent.CATEGORY_DEFAULT);
+            getContext().startActivity(chooser);
+            call.resolve();
+        } catch (Exception ex) {
+            call.reject(ex.getLocalizedMessage());
+        }
+    }
+
