# Copiar a .env.local (nunca commitear .env.local -- ya esta en .gitignore).

# Dashboard de Supabase -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Dashboard de Supabase -> Project Settings -> API -> service_role.
# SOLO server-side (API routes de src/app/api/admin/**). NUNCA con prefijo
# NEXT_PUBLIC_, NUNCA importada desde un componente "use client": otorga
# acceso total saltandose RLS.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# ---------------------------------------------------------------------
# Tokens para los conectores MCP de ESTE proyecto (.mcp.json), NO son
# variables que use la app Next.js. Van en .env (raiz del repo, ya
# ignorado por git), no en .env.local. Son credenciales temporales del
# cliente -- revocar al terminar el trabajo (ver README del handoff).
# ---------------------------------------------------------------------

# GitHub -- Personal Access Token del cliente, scope minimo necesario
# (idealmente solo "Contents" R/W sobre el repo del proyecto).
GITHUB_TOKEN=

# Supabase -- Personal Access Token del cliente
# (Dashboard -> Account -> Access Tokens).
SUPABASE_ACCESS_TOKEN=

# Vercel -- token del cliente (Account Settings -> Tokens).
VERCEL_TOKEN=
